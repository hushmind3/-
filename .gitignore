__pycache__/
*.py[cod]
.venv/
checkpoints/*.pt
runtime-global-desktop/
runtime-global-live-test/
logs/
runtime-global-web/

# Model checkpoints are excluded from Git tracking.
*.pt
*.pth
*.ckpt
*.safetensors
runtime-global-*/
replay*.csv
replay*.pt
*.sqlite3
*.log
cache/
data/cache/

# High-volume model and training state, browsable in github-large-files/
/github-large-files/
/runtime-global-korea-live/live/agent/
/runtime-global-korea-epoch1/
/runtime-global-korea-epoch1-compact/

# The private repository stores a recovery snapshot of project runtime data.
!/runtime/**
/runtime/**/*.pt
/runtime/**/*.pth
/runtime/**/*.ckpt
/runtime/**/*.safetensors
/runtime/**/*.sqlite3-shm
/runtime/**/*.sqlite3-wal
# Mutable live runtime is saved to versioned snapshots, never committed in place.
/runtime/markets/*/live/**
*.egg-info/
